# ── Supabase connection (client uses ANON key only — never service_role) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# New projects issue sb_publishable_... keys — those work here too.

# App defaults
VITE_ORG_SLUG=shwe-mini-mart
VITE_CURRENCY=MMK
VITE_TIMEZONE=Asia/Yangon
